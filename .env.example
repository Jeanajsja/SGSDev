# Valores de conexión directa de PostgreSQL. Para despliegues sin IPv6, reemplaza
# Host, Port y User por los de Transaction pooler (normalmente puerto 6543 y
# usuario postgres.<project-ref>). Usa la contraseña de PostgreSQL, no una API key.
DB_HOST=db.qgwpttpknrevnbdsjnrx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_SSLMODE=require

SUPABASE_URL=
SUPABASE_KEY=

# Genera un valor aleatorio con: openssl rand -hex 32
JWT_SECRET=

# Solo para el primer aprovisionamiento si la cuenta ancla aún no existe.
# Usa una contraseña de al menos 12 caracteres y bórrala de .env tras crear la cuenta.
SUPERADMIN_PASSWORD=
