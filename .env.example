# Valores PostgreSQL, no la URL ni la clave de la API REST de Supabase.
# Usa las credenciales de PostgreSQL, no la clave de la API REST.
# Para conexión directa: host db.<project-ref>.supabase.co, puerto 5432,
# usuario postgres. Si no tienes IPv6, usa Transaction pooler (6543) y
# el usuario postgres.<project-ref> como en estos valores.
DB_HOST=aws-1-us-east-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.qgwpttpknrevnbdsjnrx
DB_PASSWORD=replace-with-your-database-password
DB_SSLMODE=require

SUPABASE_URL=
SUPABASE_KEY=

# Genera un valor aleatorio con: openssl rand -hex 32
JWT_SECRET=

# Solo para el primer aprovisionamiento si la cuenta ancla aún no existe.
# Usa una contraseña de al menos 12 caracteres y bórrala de .env tras crear la cuenta.
SUPERADMIN_PASSWORD=

# URL pública de la app (para el enlace de "Olvidé mi contraseña")
APP_BASE_URL=http://localhost:8080

# Correo SMTP para enviar el enlace de restablecimiento
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_TLS=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# En local sin SMTP, el API puede devolver el enlace para pruebas (1=sí, 0=no)
RESET_LINK_IN_RESPONSE=1
RESET_TOKEN_MINUTES=30
